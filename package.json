{
  "name": "habitos",
  "version": "1.2.2",
  "description": "App de rastreamento de hábitos com gamificação",
  "main": "./out/main/index.cjs",
  "type": "module",
  "author": "Guilherme Gollino",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run build:mobile && npx cap sync && npx cap open android",
    "cap:apk": "npm run build:mobile && npx cap sync && cd android && gradlew assembleRelease",
    "icon:generate": "npx @capacitor/assets generate --iconBackgroundColor '#0f0f0f' --iconBackgroundColorDark '#0f0f0f' --splashBackgroundColor '#0f0f0f' --splashBackgroundColorDark '#0f0f0f' --android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@supabase/supabase-js": "^2.108.1",
    "date-fns": "^3.6.0",
    "electron-auto-launch": "^5.0.6",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.379.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "sql.js": "^1.12.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.guilherme.habitos",
    "productName": "Hábitos",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1046",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Hábitos",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "include": "resources/installer.nsh"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "GollinoGui",
      "repo": "habitos",
      "releaseType": "release"
    }
  }
}
